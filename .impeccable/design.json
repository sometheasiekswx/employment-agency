      "css": ".ds-filter{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:.625rem 1rem;border:1px solid transparent;border-radius:9px;font-size:.8125rem;font-weight:600;line-height:1.4;cursor:pointer;transition:background-color 160ms ease-out,color 160ms ease-out;min-height:2.5rem;padding:.5rem .75rem;background:transparent;color:var(--muted,#555);border-color:var(--line,#dedee3);font-weight:500;}.ds-filter[aria-pressed=true]{background:var(--secondary,#f2f2f4);color:var(--ink,#171717);border-color:#b9d4f4;}.ds-filter:hover{background:#e9ebf0;color:var(--ink,#171717);}.ds-filter:focus-visible{outline:3px solid var(--link,#076385);outline-offset:3px;}.ds-filter:active{transform:scale(.96);}@media(prefers-reduced-motion:reduce){.ds-filter{transition:none;}.ds-filter:active{transform:none;}}"
